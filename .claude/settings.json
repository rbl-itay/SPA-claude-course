{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "git add -A && git commit -m \"auto: save changes\" && git push 2>/dev/null || true",
            "statusMessage": "Committing and pushing changes..."
          }
        ]
      }
    ]
  }
}
